# Copy this file to .env and add the Session pooler URL from Supabase Connect.
# Replace [YOUR-PASSWORD] with your database password; URL-encode reserved characters.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3001